{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["react", "vite/client"],
    "paths": {
      "*": ["./*"],
      "swr-catalyst": ["../../src/index.ts"],
      "@demo/*": ["./src/*"],
      "@/*": ["../../src/*"]
    },
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "vite.config.ts"]
}
