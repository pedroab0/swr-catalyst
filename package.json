{
  "name": "swr-catalyst",
  "version": "0.2.2",
  "description": "A lightweight, declarative library to simplify data mutations with SWR.",
  "author": "Pedro Barbosa (https://github.com/pedroab0)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedroab0/swr-catalyst.git"
  },
  "keywords": [
    "swr",
    "react",
    "hooks",
    "mutation",
    "data fetching",
    "cache",
    "stale-while-revalidate"
  ],
  "type": "module",
  "main": "./dist/swr-catalyst.umd.cjs",
  "module": "./dist/swr-catalyst.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/swr-catalyst.js",
      "require": "./dist/swr-catalyst.umd.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "swr": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.0.7",
    "jsdom": "^27.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "size-limit": "^11.2.0",
    "swr": "^2.3.6",
    "typescript": "^5.9.3",
    "ultracite": "^6.3.2",
    "vite": "^7.2.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.7"
  }
}
