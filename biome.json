{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "./node_modules/ultracite/config/biome/core/biome.jsonc",
    "./node_modules/ultracite/config/biome/react/biome.jsonc"
  ],
  "javascript": {
    "globals": [
      "describe",
      "it",
      "expect",
      "beforeEach",
      "afterEach",
      "beforeAll",
      "afterAll",
      "vi",
      "React"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":BUN:", ":NODE:", ":PACKAGE:"],
              ":BLANK_LINE:",
              { "type": true },
              ":BLANK_LINE:",
              [
                "@/helpers",
                "@/helpers/**",
                "@/utils",
                "@/utils/**",
                "@/utilities",
                "@/utilities/**",
                "@/errors",
                "@/errors/**"
              ],
              [
                "**/helpers",
                "**/helpers/**",
                "**/utils",
                "**/utils/**",
                "**/utilities",
                "**/utilities/**",
                "**/errors",
                "**/errors/**"
              ],
              ":BLANK_LINE:",
              ["@/constants", "@/constants/**", "@/enums", "@/enums/**"],
              ["**/constants", "**/constants/**", "**/enums", "**/enums/**"],
              ":BLANK_LINE:",
              ["@/contexts", "@/contexts/**", "@/hooks", "@/hooks/**"],
              ["**/contexts", "**/contexts/**", "**/hooks", "**/hooks/**"],
              ":BLANK_LINE:",
              ["@/components", "@/components/**"],
              ["**/components", "**/components/**"],
              ":BLANK_LINE:",
              ["@/assets", "@/assets/**"],
              ["**/assets", "**/assets/**"],
              ":BLANK_LINE:",
              ["@/**"],
              ":BLANK_LINE:",
              [":PATH:"]
            ]
          }
        }
      }
    }
  },
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 20
          }
        }
      },
      "style": {
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["PascalCase", "camelCase"],
            "strictCase": false
          }
        },
        "useErrorCause": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/__tests__/**/*.ts",
        "**/__tests__/**/*.tsx",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noMisplacedAssertion": "off"
          },
          "style": {
            "useDestructuring": "off"
          }
        }
      }
    },
    {
      "includes": ["src/__tests__/integration/setup/vitest.setup.ts"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["examples/demo/**/*"],
      "linter": {
        "rules": {
          "performance": {
            "noJsxPropsBind": "off"
          },
          "style": {
            "noIncrementDecrement": "off"
          }
        }
      }
    }
  ]
}
